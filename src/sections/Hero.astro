
---
const name = "Kim Lozano";
const position = "Systems Analyst • Systems Developer • Tech Strategist";
---

<header class="p-6 sm:p-10 md:p-12 card-secondary flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative overflow-hidden w-full">

    <div class="space-y-2 z-10">

        <div class="flex items-center gap-2">
            <span class="inline-block card-accent text-xs uppercase px-3 py-1">
                Available for Hire
            </span>

            <span class="inline-block bg-pink-500 text-slate-950 text-xs font-black uppercase px-3 py-1 border-2 border-slate-950 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                Victorias City
            </span>
        </div>

        <h1 class="text-4xl sm:text-7xl lg:text-8xl font-bold uppercase tracking-normal text-slate-950 dark:text-pink-400 [font-family:'Fredoka',sans-serif]">
            {name}
        </h1>

        <p class="text-xs sm:text-base md:text-lg font-black text-slate-800 dark:text-slate-200">
            {position}
        </p>

        <p class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 max-w-xl leading-relaxed">
            Turning ideas into functional digital solutions through
            system development, web engineering, and creative problem-solving.
        </p>

    </div>

    <div class="flex flex-wrap gap-3 z-10">

        <button id="toggledark" class="btn-secondary">
            Mode
        </button>

        <button id="replay" class="btn-secondary">
            Replay
        </button>

        <a href="#contact" class="btn-primary">
            Hire Me
        </a>

    </div>

</header>
