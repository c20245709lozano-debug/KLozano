<section id="contact" class="md:col-span-12 p-6 sm:p-10 lg:p-12 card-secondary w-full">
            <div class="flex justify-between items-center mb-6">
                <h2
                    class="text-xs font-black bg-pink-500 text-slate-950 uppercase tracking-widest px-3.5 py-1.5 inline-block border-2 border-slate-950 dark:border-[#FAF6EE] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(250,246,238,1)]">
                    06. Contact
                </h2>
            </div>

            <form class="space-y-5 text-xs font-bold">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="space-y-1.5">
                        <label
                            class="uppercase tracking-wider font-black text-slate-900 dark:text-slate-100">Name</label>
                        <input type="text" placeholder="YOUR NAME" required
                            class="w-full p-3.5 border-3 border-slate-950 dark:border-[#FAF6EE] bg-[#FDFBF7] dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-500 focus:bg-[#FAF6EE] dark:focus:bg-slate-900 focus:outline-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(250,246,238,1)] transition-colors">
                    </div>

                    <div class="space-y-1.5">
                        <label
                            class="uppercase tracking-wider font-black text-slate-900 dark:text-slate-100">Email</label>
                        <input type="email" placeholder="YOUR EMAIL ADDRESS" required
                            class="w-full p-3.5 border-3 border-slate-950 dark:border-[#FAF6EE] bg-[#FDFBF7] dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-500 focus:bg-[#FAF6EE] dark:focus:bg-slate-900 focus:outline-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(250,246,238,1)] transition-colors">
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label
                        class="uppercase tracking-wider font-black text-slate-900 dark:text-slate-100">Message</label>
                    <textarea placeholder="PROJECT DETAILS / INQUIRIES..." rows="4" required
                        class="w-full p-3.5 border-3 border-slate-950 dark:border-[#FAF6EE] bg-[#FDFBF7] dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-500 focus:bg-[#FAF6EE] dark:focus:bg-slate-900 focus:outline-none resize-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(250,246,238,1)] transition-colors"></textarea>
                </div>

                <div class="flex flex-wrap gap-4 pt-2">
                    <button type="submit" class="btn-primary flex-1">
                        Send Message
                    </button>
                    <button type="button" class="btn-accent">
                        Urgent Direct
                    </button>
                </div>
            </form>
        </section>
